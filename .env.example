# Only needed to run from source (`python mcp_gateway.py` / `test_client.py`). The uvx /
# `claude mcp add` install passes env inline (`--env TOOL_API_KEY=...`), not via a file.

# The vip_pro API key, sent to the tool API as the API-key header on every request.
TOOL_API_KEY=

# Optional overrides (default to production):
# TOOL_BASE_URL=https://production.trackingis.info/api/external/v2
# SPEC_URL=https://production.trackingis.info/api/external/v2/openapi
